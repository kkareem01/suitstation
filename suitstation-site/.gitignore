# Local-only reference / inspiration material — not part of the site.
# Leading slash = root-only match. Without it, "Reviews/" would also match
# "assets/reviews/" on case-insensitive filesystems (macOS default).
/Reviews/
*.pdf
*inspo*.png
Screenshot*.png
Review Structure example.png
Review structure example number two.png
front end design on mobile for booking.png
www.acquisition.com_o-vegas*.png
bestofhall county logo.jpg
CLAUDE copy.md
favicon copy.ico
favicon copy.png

# High-res originals of review screenshots — only the optimized .png variants
# are referenced by the site, the .original.png files would just bloat the repo.
assets/reviews/*.original.png
.vercel

# Secrets / recovery codes — never commit.
twilio_2FA_recovery_code.txt
*_recovery_code.txt

