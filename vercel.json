{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "suitstation.us"
        }
      ],
      "destination": "https://www.suitstation.us/:path*",
      "permanent": true
    },
    {
      "source": "/lead-magnet",
      "destination": "/free-tie",
      "permanent": true
    },
    {
      "source": "/lead-magnet/:path*",
      "destination": "/free-tie/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/intake",
      "destination": "/api/leads?__route=intake"
    },
    {
      "source": "/api/google-rating",
      "destination": "/api/config?__route=google-rating"
    },
    {
      "source": "/feeds/ads-conversions.csv",
      "destination": "/api/admin/ads-conversions"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-codes",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/rotate-offer",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/nurture-t3",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/nurture-t1",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/nurture-dayof",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/sync-ad-spend",
      "schedule": "0 8 * * *"
    }
  ]
}
